# ─────────────────────────────────────────────────────────────────────────────
# PubcoZone environment. Copy to .env.local and fill in. Everything degrades
# gracefully: with NONE of these set the app runs in local-demo mode (JSON files,
# AI templates, no email). Set each group to enable that capability in production.
# ─────────────────────────────────────────────────────────────────────────────

# AI drafting / moderation / analyst (Anthropic Claude).
# Without it, the app uses deterministic templates. Optional.
ANTHROPIC_API_KEY=

# Multi-tenant persistence (Supabase). Without these, data is stored in local
# JSON files under data/ (single-machine demo only — NOT for production).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth gate. Set to 1 in production to require login for the dashboard.
AUTH_ENABLED=

# Transactional email (Resend) — powers Watch confirmations + alert emails.
# Without RESEND_API_KEY, subscribes still succeed; emails are skipped (logged).
RESEND_API_KEY=
EMAIL_FROM="PubcoZone <alerts@pubcozone.com>"

# Secures the alert cron route for manual triggers. Vercel Cron is authorized via
# its own header, so this is only needed to trigger /api/cron/watch-alerts by URL.
CRON_SECRET=

# Stripe billing. Test or live keys + the price IDs from your Stripe catalog.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SETUP=

# X posting (Ayrshare). Optional — enables publishing approved updates to X.
AYRSHARE_API_KEY=
